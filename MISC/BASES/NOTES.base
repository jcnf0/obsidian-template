formulas:
  Untitled: ""
views:
  - type: table
    name: Main
    filters:
      and:
        - file.folder == "RESEARCH/READING/PAPERS"
    order:
      - file.name
      - paper_title
      - venue
      - year
      - summary
      - file.tags
      - file.ctime
    sort:
      - property: year
        direction: ASC
      - property: file.ctime
        direction: DESC
      - property: paper_title
        direction: DESC
      - property: venue
        direction: ASC
    columnSize:
      file.name: 152
      note.paper_title: 345
      note.summary: 362
  - type: table
    name: TODO
    filters:
      and:
        - file.tags.contains("TODO/READ")
        - file.folder == "RESEARCH/READING/NOTES"
    imageAspectRatio: 1
    cardSize: 260
